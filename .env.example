# ==============================================================================
# trievo-queue Microservice Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Redis Connection Settings
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT=3.0
REDIS_SOCKET_TIMEOUT=3.0
# When running locally without a standalone Redis server, allow in-memory fallback for testing/dev
USE_FAKE_REDIS_FALLBACK=true

# Queue Partitioning & Storage
QUEUE_KEY_PREFIX=queue:
QUEUE_DEFAULT_PARTITION=ed

# Priority Tier Base Weights (Higher = Higher Priority)
TIER_CRITICAL_WEIGHT=1000000.0
TIER_URGENT_WEIGHT=500000.0
TIER_SEMI_URGENT_WEIGHT=200000.0
TIER_NON_URGENT_WEIGHT=50000.0

# Arrival-time Fairness Configuration
# Fairness points earned per minute of waiting time
FAIRNESS_WEIGHT_PER_MINUTE=10.0
# Maximum fairness bonus: MUST be strictly less than tier separation (e.g. 150000)
# so non-critical cases can NEVER surpass critical cases.
MAX_FAIRNESS_BONUS=40000.0

# Estimated Wait Time Settings
# Default average consultation/service minutes per patient
DEFAULT_WAIT_TIME_MINUTES=15.0

# Stale Case Escalation Monitor Settings
ENABLE_ESCALATION_MONITOR=true
# How often the escalation monitor runs (in seconds)
QUEUE_ESCALATION_INTERVAL_SECONDS=30
# Global stale threshold minutes (fallback)
QUEUE_STALE_THRESHOLD_MINUTES=45.0
# Priority-specific stale thresholds (in minutes)
STALE_THRESHOLD_CRITICAL_MINUTES=10.0
STALE_THRESHOLD_URGENT_MINUTES=30.0
STALE_THRESHOLD_SEMI_URGENT_MINUTES=60.0
STALE_THRESHOLD_NON_URGENT_MINUTES=120.0

# Maximum number of times a case can be escalated
MAX_ESCALATION_LEVEL=3
# Score boost added per escalation level
ESCALATION_BOOST_SCORE=25000.0
# Escalation level at which an alert is automatically triggered
ALERT_TRIGGER_ESCALATION_LEVEL=1

# Alert Dispatcher Settings
CRITICAL_ALERT_ENABLED=true
ENABLE_BACKGROUND_SUBSCRIBER=true

# Event Bus Channels (Redis Pub/Sub)
CHANNEL_VERIFY_COMPLETED=trievo.verify.completed
CHANNEL_QUEUE_UPDATED=trievo.queue.updated
CHANNEL_QUEUE_ALERT=trievo.queue.alert
